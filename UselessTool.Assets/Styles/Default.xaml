<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="clr-namespace:UselessTool.Utilities.Attached;assembly=UselessTool.Utilities"
    xmlns:ws="https://schemas.elecho.dev/wpfsuite">

    <Style x:Key="Border.ButtonBack.Style" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="attached:BorderHelper.AutoCornerRadius" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ComboBox.Colors.Style"
        BasedOn="{StaticResource ComboBox.Base.Style}"
        TargetType="ws:ComboBox">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            Fill="{Binding Brush}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.WinButton.Style" TargetType="{x:Type ws:Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="HoverBackground" Value="{DynamicResource Light.HoverBackgroundColor}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Light.PressedBackgroundColor}" />
        <Style.Triggers>
            <!--  Mouse Over Triggers  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="HoverBackground" Value="{DynamicResource Light.HoverBackgroundColor}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="HoverBackground" Value="{DynamicResource Dark.HoverBackgroundColor}" />
            </MultiDataTrigger>

            <!--  Pressed Triggers  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBackground" Value="{DynamicResource Light.PressedBackgroundColor}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBackground" Value="{DynamicResource Dark.PressedBackgroundColor}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style 
        x:Key="Button.IconFont.Style"
        BasedOn="{StaticResource Button.Base.Style}" 
        TargetType="{x:Type ws:Button}">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
    </Style>
 
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Text.ForegroundColor}" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,0,10,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ws:BoxPanel
                            Height="{TemplateBinding ActualHeight}"
                            Width="{TemplateBinding ActualHeight}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}">
                            <Border  
                                BorderBrush="{DynamicResource Control.BorderBrushColor}"
                                BorderThickness="1"
                                CornerRadius="3" />
                            <Path
                                x:Name="IconElement"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M17.5625,6.5625 L10.0005,14.188 6.5004996,10.53201 5.0942497,11.875848 10.031599,16.876176 19.000529,8.0005944"
                                Fill="{DynamicResource Control.PressedBorderBrushColor}"
                                Stretch="Uniform"
                                Visibility="Hidden" />
                        </ws:BoxPanel>
                        <ContentPresenter
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconElement" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleButton.SwitchBackground.Style" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text.ForegroundColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentControl
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                            FontFamily="{TemplateBinding FontFamily}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Control.HoverBackgroundColor}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="{DynamicResource Control.PressedBorderBrushColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>