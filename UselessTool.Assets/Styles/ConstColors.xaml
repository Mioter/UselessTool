<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--此页面存储几乎不改变且不应发生改变的颜色-->
    
    <!-- 警告和状态 -->
    <SolidColorBrush x:Key="Error.Color" Color="#FFF44336"/> <!-- 红色错误信息 -->
    <SolidColorBrush x:Key="Warning.Color" Color="#FFFF9800"/> <!-- 橙色警告信息 -->
    <SolidColorBrush x:Key="Success.Color" Color="#FF4CAF50"/> <!-- 绿色成功信息 -->
    <SolidColorBrush x:Key="Info.Color" Color="#FF2196F3"/> <!-- 蓝色信息提示 -->
    
    <!--滑块颜色-->
    <SolidColorBrush x:Key="ScrollBar.TrackColor" Color="#FFCCCCCC"/> <!-- 滚动条轨道颜色 -->
    <SolidColorBrush x:Key="ScrollBar.ThumbColor" Color="#FF9E9E9E"/> <!-- 滚动条滑块颜色 -->
    
    <!--按钮背景色-->
    <SolidColorBrush x:Key="Light.HoverBackgroundColor" Color="#30000000"/> <!-- 鼠标悬停时的浅灰色背景 -->
    <SolidColorBrush x:Key="Light.PressedBackgroundColor" Color="#50000000"/> <!-- 按下时的深灰色背景 -->
    <SolidColorBrush x:Key="Dark.HoverBackgroundColor" Color="#50FFFFFF"/> <!-- 鼠标悬停时的浅灰色背景 -->
    <SolidColorBrush x:Key="Dark.PressedBackgroundColor" Color="#30FFFFFF"/> <!-- 按下时的深灰色背景 -->
    
</ResourceDictionary>