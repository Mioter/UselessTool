<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  基础颜色  -->
    <SolidColorBrush x:Key="Base.BackgroundColor" Color="#FF121212" />

    <SolidColorBrush x:Key="Base.ForegroundColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Base.AccentColor" Color="#FF6200EE" />


    <!--  控件背景色  -->
    <SolidColorBrush x:Key="Control.BackgroundColor" Color="#FF1F1F1F" />

    <SolidColorBrush x:Key="Control.HoverBackgroundColor" Color="#FF383838" />

    <SolidColorBrush x:Key="Control.PressedBackgroundColor" Color="#FF2A2A2A" />

    <!--  控件边框色  -->
    <SolidColorBrush x:Key="Control.BorderBrushColor" Color="#FF6bA4F9" />

    <SolidColorBrush x:Key="Control.HoverBorderBrushColor" Color="#FF3E92F9" />

    <SolidColorBrush x:Key="Control.PressedBorderBrushColor" Color="#FF1468F9" />

    <!--  文本颜色  -->
    <SolidColorBrush x:Key="Text.ForegroundColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Text.DeputyLevelColor" Color="#FFBDBDBD" />

    <SolidColorBrush x:Key="Text.PlaceholderColor" Color="#FF6A6A6A" />

    <!--  边框和分隔线颜色  -->
    <SolidColorBrush x:Key="Border.Color" Color="#FF424242" />

    <SolidColorBrush x:Key="Border.AccentColor" Color="#FF6200EE" />

    <SolidColorBrush x:Key="Separator.Color" Color="#FF383838" />

    <!--  交互元素颜色  -->
    <SolidColorBrush x:Key="Hyperlink.Color" Color="#FF6200EE" />

    <SolidColorBrush x:Key="Hyperlink.VisitedColor" Color="#FFAA66CC" />

    <!--  其他UI元素颜色  -->
    <SolidColorBrush x:Key="Header.BackgroundColor" Color="#FF6200EE" />

    <SolidColorBrush x:Key="Header.TextColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Footer.BackgroundColor" Color="#FF2A2A2A" />

    <SolidColorBrush x:Key="Footer.TextColor" Color="#FFBDBDBD" />

</ResourceDictionary>
