<Application
    x:Class="UselessTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:UselessTool.Utilities.Converter;assembly=UselessTool.Utilities"
    StartupUri="View/MainView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UselessTool.Theme;component/Resources/Colour/Light/White.xaml" />
                <ResourceDictionary Source="Assets/Styles/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  转换器定义  -->
            <converter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
            <!--<converter:MathConverter x:Key="MathConverter" />-->
        </ResourceDictionary>
    </Application.Resources>
</Application>
