<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="clr-namespace:UselessTool.Utilities.Attached;assembly=UselessTool.Utilities"
    xmlns:ws="https://schemas.elecho.dev/wpfsuite">

    <Style x:Key="Border.ButtonBack.Style" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="attached:BorderHelper.AutoCornerRadius" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ComboBox.Colors.Style"
        BasedOn="{StaticResource ComboBox.Base.Style}"
        TargetType="ws:ComboBox">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            Fill="{Binding Brush}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.WinButton.Style" TargetType="{x:Type ws:Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="HoverBackground" Value="{DynamicResource Light.HoverBackgroundColor}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Light.PressedBackgroundColor}" />
        <Style.Triggers>
            <!--  Mouse Over Triggers  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="HoverBackground" Value="{DynamicResource Light.HoverBackgroundColor}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="HoverBackground" Value="{DynamicResource Dark.HoverBackgroundColor}" />
            </MultiDataTrigger>

            <!--  Pressed Triggers  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBackground" Value="{DynamicResource Light.PressedBackgroundColor}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding DataContext.ThemeControl.IsNightChecked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBackground" Value="{DynamicResource Dark.PressedBackgroundColor}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>