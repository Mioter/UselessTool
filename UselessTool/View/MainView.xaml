<Window
    x:Class="UselessTool.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:UselessTool.Utilities.Attached;assembly=UselessTool.Utilities"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cc="clr-namespace:UselessTool.Control.Controls;assembly=UselessTool.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:UselessTool.Theme.Core;assembly=UselessTool.Theme"
    xmlns:userControls="clr-namespace:UselessTool.View.UserControls"
    xmlns:viewmodel="clr-namespace:UselessTool.ViewModel"
    xmlns:ws="https://schemas.elecho.dev/wpfsuite"
    Title="MainView"
    Width="1200"
    Height="800"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
    ws:WindowOption.IsCaptionMenuVisible="False"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Grid theme:ThemeProps.Background="{DynamicResource Base.BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" theme:ThemeProps.Background="{DynamicResource Header.BackgroundColor}">
            <Label
                Content="Useless Tools"
                FontSize="12"
                FontWeight="Bold"
                Foreground="{DynamicResource Header.TextColor}"
                Style="{StaticResource Label.Base.Style}" />
            <ws:UniformGrid
                Width="250"
                HorizontalAlignment="Right"
                Columns="5"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <ws:Button
                        Name="ThemeButton"
                        Command="{Binding ThemeControl.ToggleThemeViewCommand}"
                        Foreground="{DynamicResource Header.TextColor}"
                        Style="{DynamicResource Button.WinButton.Style}"
                        Visibility="{Binding Converter={StaticResource ValueToVisibilityConverter}}">
                        <ws:ConditionalControl Condition="{Binding ThemeControl.IsOpenThemeView}">
                            <ws:ConditionalControl.ContentWhenTrue>
                                <Border
                                    ap:BorderHelper.AutoCornerRadius="True"
                                    BorderBrush="{DynamicResource Header.TextColor}"
                                    BorderThickness="1">
                                    <TextBlock Margin="5" Text="&#xe775;" />
                                </Border>
                            </ws:ConditionalControl.ContentWhenTrue>
                            <ws:ConditionalControl.ContentWhenFalse>
                                <TextBlock Text="&#xe775;" />
                            </ws:ConditionalControl.ContentWhenFalse>
                        </ws:ConditionalControl>
                    </ws:Button>
                    <!--  主题切换视图  -->
                    <cc:PopupEx
                        AllowsTransparency="True"
                        IsOpen="{Binding ThemeControl.IsOpenThemeView}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ThemeButton}"
                        PopupAnimation="Slide">
                        <userControls:ThemeToggleView />
                    </cc:PopupEx>
                </Grid>
                <ws:Button
                    Command="{Binding ThemeControl.ToggleDayModeNightModeCommand}"
                    Foreground="{DynamicResource Header.TextColor}"
                    Style="{DynamicResource Button.WinButton.Style}">
                    <ws:ConditionalControl Condition="{Binding ThemeControl.IsNightChecked}">
                        <ws:ConditionalControl.ContentWhenTrue>
                            <TextBlock Text="&#xe622;" />
                        </ws:ConditionalControl.ContentWhenTrue>
                        <ws:ConditionalControl.ContentWhenFalse>
                            <TextBlock Text="&#xe8af;" />
                        </ws:ConditionalControl.ContentWhenFalse>
                    </ws:ConditionalControl>
                </ws:Button>
                <ws:Button
                    Command="{Binding TitleBarViewMode.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe65a;"
                    Foreground="{DynamicResource Header.TextColor}"
                    Style="{DynamicResource Button.WinButton.Style}" />
                <ws:Button
                    ws:WindowOption.IsMaximumButton="True"
                    Command="{Binding TitleBarViewMode.ToggleWindowStateCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource Header.TextColor}"
                    Style="{DynamicResource Button.WinButton.Style}">
                    <ws:ConditionalControl Condition="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static ws:NotEqualConverter.Instance}, ConverterParameter={x:Static WindowState.Maximized}}">
                        <ws:ConditionalControl.ContentWhenTrue>
                            <TextBlock Text="&#xe651;" />
                        </ws:ConditionalControl.ContentWhenTrue>
                        <ws:ConditionalControl.ContentWhenFalse>
                            <TextBlock Text="&#xe614;" />
                        </ws:ConditionalControl.ContentWhenFalse>
                    </ws:ConditionalControl>
                </ws:Button>
                <ws:Button
                    Command="{Binding TitleBarViewMode.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    Foreground="{DynamicResource Header.TextColor}"
                    IsCancel="True"
                    PressedBackground="Red"
                    PressedForeground="White"
                    Style="{DynamicResource Button.WinButton.Style}" />
            </ws:UniformGrid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Width="200"
                Margin="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <ws:ComboBox
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding CombboxList}"
                    SelectedItem="{Binding CombboxItem}"
                    Style="{StaticResource ComboBox.Base.Style}" />
                <ws:TextBox
                    Padding="5.5"
                    Placeholder="我没得用，请无视我-XoX-"
                    PlaceholderBrush="HotPink"
                    Style="{StaticResource TextBox.Base.Style}"
                    Text="{Binding NameOfThemesAdded}" />
                <ws:Button
                    Command="{Binding TestAddThemeCommand}"
                    Content="确认添加"
                    Style="{StaticResource Button.Base.Style}" />
                <ws:Button
                    Margin="0,8"
                    Command="{Binding RefreshThemeViewCommand}"
                    Content="刷新"
                    Style="{StaticResource Button.Base.Style}" />
            </StackPanel>
            <TextBox
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="15"
                Foreground="Red"
                Text="{Binding TipsText}" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15,10" Orientation="Vertical">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Loaded">
                            <b:InvokeCommandAction Command="{Binding SetConfigurationPanelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
