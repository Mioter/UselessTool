<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  基础颜色  -->
    <SolidColorBrush x:Key="Base.BackgroundColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Base.ForegroundColor" Color="#FF424242" />

    <SolidColorBrush x:Key="Base.AccentColor" Color="#FF1E88E5" />
    
    <!--  控件背景色  -->
    <SolidColorBrush x:Key="Control.BackgroundColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Control.HoverBackgroundColor" Color="#FFE0E0E0" />

    <SolidColorBrush x:Key="Control.PressedBackgroundColor" Color="#FFD0D0D0" />

    <!--  控件边框色  -->
    <SolidColorBrush x:Key="Control.BorderBrushColor" Color="#FF6bA4F9" />
    
    <SolidColorBrush x:Key="Control.HoverBorderBrushColor" Color="#FF3E92F9" />

    <SolidColorBrush x:Key="Control.PressedBorderBrushColor" Color="#FF1468F9" />

    <!--  文本颜色  -->
    <SolidColorBrush x:Key="Text.ForegroundColor" Color="#FF000000" />

    <SolidColorBrush x:Key="Text.DeputyLevelColor" Color="#FF5E5E5E" />

    <SolidColorBrush x:Key="Text.PlaceholderColor" Color="#FF808080" />

    <!--  边框和分隔线颜色  -->
    <SolidColorBrush x:Key="Border.Color" Color="#FFCCCCCC" />

    <SolidColorBrush x:Key="Border.AccentColor" Color="#FF1E88E5" />

    <SolidColorBrush x:Key="Separator.Color" Color="#FFE0E0E0" />
    
    <!--  交互元素颜色  -->
    <SolidColorBrush x:Key="Hyperlink.Color" Color="#FF1E88E5" />

    <SolidColorBrush x:Key="Hyperlink.VisitedColor" Color="#FF9C27B0" />

    <!--  其他UI元素颜色  -->
    <SolidColorBrush x:Key="Header.BackgroundColor" Color="#FF1E88E5" />
 
    <SolidColorBrush x:Key="Header.TextColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Footer.BackgroundColor" Color="#FFE0E0E0" />

    <SolidColorBrush x:Key="Footer.TextColor" Color="#FF000000" />

</ResourceDictionary>